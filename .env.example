# Databricks Configuration

# Option A: Specify Host and Serving Endpoint Name
# Example Databricks Host URL: https://adb-1234567890123456.7.azuredatabricks.net or https://dbc-xxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=https://<your-databricks-instance>

# Name of your Databricks Serving Endpoint (as seen in Databricks UI under Serving)
DATABRICKS_ENDPOINT_NAME=wine-quality-endpoint

# Personal Access Token (PAT) generated from Databricks User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=dapi...

# Option B: Alternatively, specify the full direct serving invocations URL (overrides HOST + ENDPOINT_NAME if provided)
# DATABRICKS_SERVING_URL=https://<your-databricks-instance>/serving-endpoints/<endpoint-name>/invocations
